{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "matter/breadcrumb",
    "title": "Breadcrumb",
    "category": "matter",
    "description": "Percorso di navigazione (Home › pagina corrente). Imposta l'etichetta corrente per istanza.",
    "textdomain": "matter-blocks",
    "editorScript": "file:./index.js",
    "render": "file:./render.php",
    "supports": {
        "html": false,
        "anchor": true,
        "align": [ "wide", "full" ]
    },
    "attributes": {
        "home-url": {
            "type": "string",
            "default": "/"
        },
        "parent-label": {
            "type": "string",
            "default": ""
        },
        "parent-url": {
            "type": "string",
            "default": ""
        },
        "current": {
            "type": "string",
            "default": "Pagina corrente"
        }
    }
}
