{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "matter/media-cta",
  "title": "Media CTA",
  "category": "matter",
  "description": "Banner tinta con immagine a sinistra, testo e un bottone. Contenuto impostato per istanza.",
  "textdomain": "matter-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "image": {
      "type": "object",
      "default": {
        "url": "https://images.unsplash.com/photo-1518611012118-696072aa579a?w=900&q=80",
        "alt": "Programma su misura",
        "id": 0
      }
    },
    "kicker": {
      "type": "string",
      "default": "Su misura"
    },
    "title": {
      "type": "string",
      "default": "Hai un'esigenza specifica?"
    },
    "desc": {
      "type": "string",
      "default": "Se nessuno dei percorsi è adatto alla tua situazione, possiamo costruirne uno dedicato a partire dall'anamnesi e dagli obiettivi."
    },
    "cta": {
      "type": "object",
      "default": {
        "url": "/contatti/",
        "label": "Parliamone",
        "target": ""
      }
    }
  }
}