{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "slug": "bg",
          "name": "Bg",
          "color": "#ffffff"
        },
        {
          "slug": "bg-tint",
          "name": "Bg Tint",
          "color": "rgba(18, 79, 79, 0.05)"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#100f0d"
        },
        {
          "slug": "ink-2",
          "name": "Ink 2",
          "color": "#0a0a0a"
        },
        {
          "slug": "ink-3",
          "name": "Ink 3",
          "color": "#0c1f1f"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#5c5c5c"
        },
        {
          "slug": "muted-2",
          "name": "Muted 2",
          "color": "#808080"
        },
        {
          "slug": "teal",
          "name": "Teal",
          "color": "#155051"
        },
        {
          "slug": "teal-soft",
          "name": "Teal Soft",
          "color": "rgba(18, 79, 79, 0.05)"
        },
        {
          "slug": "primary",
          "name": "Primary",
          "color": "var(--color-teal)"
        },
        {
          "slug": "primary-hover",
          "name": "Primary Hover",
          "color": "#0d3f40"
        },
        {
          "slug": "on-primary",
          "name": "On Primary",
          "color": "#ffffff"
        },
        {
          "slug": "divider",
          "name": "Divider",
          "color": "#dddcdc"
        },
        {
          "slug": "footer-bg",
          "name": "Footer Bg",
          "color": "#000000"
        },
        {
          "slug": "footer-text",
          "name": "Footer Text",
          "color": "#b8b8b8"
        },
        {
          "slug": "footer-heading",
          "name": "Footer Heading",
          "color": "#737373"
        },
        {
          "slug": "footer-faint",
          "name": "Footer Faint",
          "color": "#666"
        },
        {
          "slug": "faq-bg",
          "name": "Faq Bg",
          "color": "#100f0d"
        },
        {
          "slug": "lounge-accent",
          "name": "Lounge Accent",
          "color": "#9fd8c8"
        }
      ],
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "defaultDuotone": true,
      "defaultGradients": true,
      "defaultPalette": false,
      "link": true
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Sans",
          "fontFamily": "\"Google Sans Flex\", system-ui, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"Google Sans Code\", system-ui, sans-serif"
        },
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Google Sans Flex\", system-ui, sans-serif"
        }
      ],
      "fontSizes": [],
      "customFontSize": true,
      "dropCap": false,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true,
      "writingMode": false
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "mobile-gutter",
          "name": "Mobile Gutter",
          "size": "20px"
        }
      ],
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true,
      "radiusSizes": [
        {
          "slug": "card",
          "name": "Card",
          "size": "32px"
        },
        {
          "slug": "img",
          "name": "Img",
          "size": "16px"
        },
        {
          "slug": "nav",
          "name": "Nav",
          "size": "24px"
        },
        {
          "slug": "hero",
          "name": "Hero",
          "size": "48px"
        },
        {
          "slug": "full",
          "name": "Full",
          "size": "9999px"
        }
      ]
    },
    "shadow": {
      "defaultPresets": true,
      "presets": []
    },
    "custom": {
      "header-h": "127px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background, #ffffff)",
      "text": "var(--wp--preset--color--text, #111111)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body, sans-serif)",
      "fontSize": "var(--wp--preset--font-size--md, 1rem)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading, sans-serif)",
          "fontWeight": "700",
          "lineHeight": "1.1"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "about",
      "title": "About",
      "postTypes": [ "page" ]
    }
  ]
}
